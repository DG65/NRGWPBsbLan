{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖 Documentation & help",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "name": "VersionInfo",
                    "caption": ""
                },
                {
                    "type": "Label",
                    "caption": "Reads a heating system/heat pump via a local BSB-LAN adapter (github.com/fredlcore/bsb_lan) -- without internet, without a manufacturer account. Details: https://github.com/DG65/NRGWPBsbLan"
                },
                {
                    "type": "Label",
                    "caption": "Steps: 1. Enter the IP address (and, if needed, port/password) of the BSB-LAN adapter → 2. Check/adjust the parameter numbers for your system (pre-filled with values confirmed on a Fujitsu Waterstage) → 3. Apply → 4. Switch on \"WPBsbLan active\" and apply again."
                },
                {
                    "type": "Button",
                    "caption": "🔄 Force apply (without a form change)",
                    "confirm": "Really force ApplyChanges()? Handy right after a module update via the module control.",
                    "onClick": "IPS_ApplyChanges($id); echo '✅ ApplyChanges()';"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "GeneralPanel",
            "caption": "🔧 General",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "WPBSBL_Active",
                    "caption": "WPBsbLan active"
                },
                {
                    "type": "NumberSpinner",
                    "name": "WPBSBL_Interval",
                    "caption": "Update interval (seconds)",
                    "minimum": 30,
                    "maximum": 600,
                    "suffix": " s"
                },
                {
                    "type": "Label",
                    "caption": "📈 Archiving: the module never switches on logging in the Symcon archive by itself. With the button below you deliberately enable it for all measured values (floating-point variables) of this instance, e.g. for charts and evaluations. Logging that is already enabled stays untouched."
                },
                {
                    "type": "Button",
                    "caption": "📈 Enable logging for the measured values",
                    "onClick": "echo WPBSBL_EnableArchiving($id);"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ConnectionPanel",
            "caption": "🔌 BSB-LAN adapter",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "name": "ConnectionStatus",
                    "caption": ""
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "ValidationTextBox",
                            "name": "Host",
                            "caption": "IP address / host name of the BSB-LAN adapter"
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "Port",
                            "caption": "Port",
                            "minimum": 1,
                            "maximum": 65535
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "CheckBox",
                            "name": "UseHttps",
                            "caption": "HTTPS instead of HTTP"
                        },
                        {
                            "type": "PasswordTextBox",
                            "name": "Password",
                            "caption": "BSB-LAN password (if set up, otherwise leave empty)"
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "name": "ParameterPanel",
            "caption": "🌡️ Parameter assignment",
            "expanded": true,
            "items": [
                {
                    "type": "Label",
                    "caption": "BSB-LAN parameter numbers differ from system to system -- the pre-filled values come from a real Fujitsu Waterstage (Siemens RVS21.831/127) where they were confirmed. Adjust them if needed for another heating system/heat pump (0 = field not present/not used)."
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ParamAussentemperatur",
                            "caption": "Outdoor temperature",
                            "minimum": 0,
                            "maximum": 99999
                        },
                        {
                            "type": "PopupButton",
                            "caption": "Where do I get the right parameter number?",
                            "width": "480px",
                            "popup": {
                                "caption": "Where do I get the right parameter number?",
                                "items": [
                                    {
                                        "type": "Label",
                                        "caption": "In the BSB-LAN web interface under \"Settings\" or the categories -- the parameter number is shown right next to the respective value. Alternatively, calling the URL http://<your-bsb-lan-address>/JQ=<number> in the browser returns a JSON answer with the name and current value for cross-checking."
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ParamVorlauftemperatur",
                            "caption": "Flow temperature",
                            "minimum": 0,
                            "maximum": 99999
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ParamRuecklauftemperatur",
                            "caption": "Return temperature",
                            "minimum": 0,
                            "maximum": 99999
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ParamWarmwasser",
                            "caption": "Hot water actual",
                            "minimum": 0,
                            "maximum": 99999
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ParamWarmwasserSoll",
                            "caption": "Hot water target",
                            "minimum": 0,
                            "maximum": 99999
                        }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        {
                            "type": "NumberSpinner",
                            "name": "ParamBetriebsart",
                            "caption": "Operating mode heating circuit 1 (the plain-text name comes directly from BSB-LAN)",
                            "minimum": 0,
                            "maximum": 99999
                        },
                        {
                            "type": "NumberSpinner",
                            "name": "ParamBetriebsartKuehl1",
                            "caption": "Operating mode cooling circuit 1",
                            "minimum": 0,
                            "maximum": 99999
                        }
                    ]
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "BSB-LAN adapter not reachable -- check IP address/port/password"
        }
    ]
}
